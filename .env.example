# Example environment variables for local development
# Copy this file to .env and adjust values before starting the server

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/pharmacy_dev

# Server
PORT=5005
NODE_ENV=development

# Client / Mobile allowed origins (optional)
CLIENT_URL=http://localhost:5173
MOBILE_URL=http://localhost:19006

# JWT secrets (replace with strong random strings in production)
JWT_SECRET=change_this_secret_to_a_long_random_value
JWT_REFRESH_SECRET=change_this_refresh_secret_to_a_long_random_value
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Gmail SMTP (optional - used for password reset OTPs)
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Development flags
DEV_SEND_OTP_IN_TERMINAL=true
